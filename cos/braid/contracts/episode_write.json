{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "braid/episode_write",
  "title": "episode write contract",
  "description": "Validated by cos.braid.validate.validate_braid(record, 'episode') before any cos.memory write. Rejections raise BraidRejection and are logged to <state>/braid_rejections.log.",
  "type": "object",
  "required": ["title", "content", "occurred_at"],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 4,
      "maxLength": 200
    },
    "content": {
      "type": "string",
      "minLength": 20,
      "maxLength": 8000
    },
    "occurred_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO date (YYYY-MM-DD)"
    },
    "session": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "valence": {
      "enum": ["negative", "neutral", "positive", null]
    },
    "fact_refs": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 16
    }
  }
}
