{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "braid/fact_write",
  "title": "fact write contract",
  "description": "Validated by cos.braid.validate.validate_braid(record, 'fact') before any cos.memory write. Rejections raise BraidRejection and are logged to <state>/braid_rejections.log.",
  "type": "object",
  "required": ["content", "category", "source", "valid_from", "tx_from"],
  "additionalProperties": false,
  "properties": {
    "content": {
      "type": "string",
      "minLength": 5,
      "maxLength": 2000
    },
    "category": {
      "enum": [
        "person",
        "project",
        "decision",
        "preference",
        "commitment",
        "incident",
        "capability",
        "reference"
      ]
    },
    "subject_type": {
      "enum": ["person", "project", "system", "place", "concept", "tool", null]
    },
    "subject_id": {
      "type": ["string", "null"],
      "maxLength": 120
    },
    "source": {
      "enum": [
        "session_log",
        "dreaming",
        "manual",
        "import",
        "radar",
        "audit",
        "reconcile"
      ]
    },
    "source_session": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "valid_from": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO date (YYYY-MM-DD)"
    },
    "valid_to": {
      "type": ["string", "null"],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO date or null"
    },
    "tx_from": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}\\.\\d{3}$",
      "description": "ms-precision timestamp (YYYY-MM-DD HH:MM:SS.mmm), matches cos.memory.writers._now() output"
    },
    "supersedes_id": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 16
    }
  }
}
